+	if s == 1 {
+		img, _ := softwareDrawDepth(f, 1, depth)
+		return img
+	}
+	big := f
+	big.Width, big.Height, big.Overlays = f.Width*s, f.Height*s, nil
+	bigImg, _ := softwareDrawDepth(big, s, depth)
+	img := shrink(bigImg, s, f.Linear)
+	drawOverlays(img, f)
+	return img
+}
