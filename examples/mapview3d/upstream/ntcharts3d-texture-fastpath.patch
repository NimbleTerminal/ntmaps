+package ntcharts3d
+
+import (
+	"image"
+	"image/color"
+	"testing"
+)
+
+func TestTextureTypedOpacitySubimages(t *testing.T) {
+	for _, nrgba := range []bool{false, true} {
+		var src interface {
+			image.Image
+			Set(int, int, color.Color)
+		}
+		if nrgba {
+			src = image.NewNRGBA(image.Rect(-5, 7, 19, 29))
+		} else {
+			src = image.NewRGBA(image.Rect(-5, 7, 19, 29))
+		}
+		bounds := image.Rect(-2, 9, 13, 21)
+		for y := bounds.Min.Y; y < bounds.Max.Y; y++ {
+			for x := bounds.Min.X; x < bounds.Max.X; x++ {
+				src.Set(x, y, color.RGBA{R: 100, A: 255})
+			}
+		}
+		var sub image.Image
+		switch img := src.(type) {
+		case *image.RGBA:
+			sub = img.SubImage(bounds)
+		case *image.NRGBA:
+			sub = img.SubImage(bounds)
+		}
+		if _, err := NewTexture(sub); err != nil {
+			t.Fatalf("opaque subimage: %v", err)
+		}
+		src.Set(bounds.Min.X, bounds.Min.Y, color.RGBA{A: 254})
+		if _, err := NewTexture(sub); err == nil {
+			t.Fatal("accepted translucent subimage")
+		}
+	}
+}
